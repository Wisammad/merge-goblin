#!/usr/bin/env bash
#
# Fake `gh` for offline tests.
#
# Two jobs:
#   1. log every invocation to $GH_FAKE_LOG, so a test can assert what was called
#      AND — more usefully — what was *not*. "this gate makes zero API calls" is a
#      property worth pinning, and it is unprovable without a call log.
#   2. serve canned responses from $GH_FAKE_DIR.
#
# Controls:
#   GH_FAKE_LOG      file to append one line per invocation (default: none)
#   GH_FAKE_DIR      directory of canned responses
#   GH_FAKE_USER     login that `gh api user` and `gh auth token` resolve to
#   GH_FAKE_PRS      file whose contents `gh pr list` returns
#   GH_FAKE_SEARCH   file returned by `gh api search/issues`
#   GH_FAKE_PULLS_DIR  files named owner__repo__PR.json for pull metadata
#   GH_FAKE_REFS     newline list of refs `git/matching-refs/...` returns
#   GH_FAKE_STATUS_POST_REFS   http code for POST git/refs (default 201)
#
# Anything unrecognised exits 0 with empty output: these tests are about the
# engine's decisions, not about reimplementing GitHub.

[ -n "${GH_FAKE_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_FAKE_LOG"

# --- auth -----------------------------------------------------------------
case "${1:-}" in
  auth)
    case "${2:-}" in
      token)
        # `gh auth token --user X` exits non-zero for an account gh has no
        # credential for. doctor_identity branches on exactly that, so the fake
        # has to draw the same line instead of handing out a token for any name.
        u=""
        while [ $# -gt 0 ]; do
          case "$1" in -u|--user) u="${2:-}"; shift 2 ;; *) shift ;; esac
        done
        [ -n "$u" ] && [ "$u" != "${GH_FAKE_USER:-me}" ] && exit 1
        printf 'gho_faketoken\n'; exit 0 ;;
      status) printf 'Logged in to github.com account %s\n' "${GH_FAKE_USER:-me}"; exit 0 ;;
      *) exit 0 ;;
    esac ;;
esac

# --- pr list --------------------------------------------------------------
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "list" ]; then
  if [ -n "${GH_FAKE_PRS:-}" ] && [ -f "$GH_FAKE_PRS" ]; then cat "$GH_FAKE_PRS"; else printf '[]\n'; fi
  exit 0
fi

# --- api ------------------------------------------------------------------
if [ "${1:-}" = "api" ]; then
  # Find the method and the path among the args.
  method=GET; path=""; include=false
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -X) method="$2"; shift 2 ;;
      --include) include=true; shift ;;
      --paginate|--silent) shift ;;
      -f|--field|-F|--raw-field) shift 2 ;;
      --jq|-q) shift 2 ;;
      -*) shift ;;
      *) [ -z "$path" ] && path="$1"; shift ;;
    esac
  done

  case "$method:$path" in
    POST:*git/refs)
      code="${GH_FAKE_STATUS_POST_REFS:-201}"
      if [ "$include" = true ]; then printf 'HTTP/2 %s\n\n' "$code"; fi
      [ "$code" = "201" ] || exit 1
      exit 0 ;;
    DELETE:*) exit 0 ;;
  esac

  case "$path" in
    user)
      printf '{"login":"%s"}\n' "${GH_FAKE_USER:-me}"; exit 0 ;;
    search/issues)
      if [ -n "${GH_FAKE_SEARCH:-}" ] && [ -f "$GH_FAKE_SEARCH" ]; then
        cat "$GH_FAKE_SEARCH"
      else
        printf '{"items":[]}\n'
      fi
      exit 0 ;;
    *git/matching-refs/*)
      if [ -n "${GH_FAKE_REFS:-}" ]; then
        printf '%s\n' "$GH_FAKE_REFS" | grep . | while IFS= read -r r; do
          printf '%s\n' "$r"
        done
      fi
      exit 0 ;;
    repos/*/pulls/*/reviews) printf '\n'; exit 0 ;;
    repos/*/pulls/*)
      if [ -n "${GH_FAKE_PULLS_DIR:-}" ]; then
        pull_key="$(printf '%s' "$path" | sed 's|^repos/||; s|/pulls/|__|; s|/|__|g').json"
        [ -f "$GH_FAKE_PULLS_DIR/$pull_key" ] && { cat "$GH_FAKE_PULLS_DIR/$pull_key"; exit 0; }
      fi
      exit 0 ;;
    repos/*/commits/*) printf 'anchorsha000000\n'; exit 0 ;;
    repos/*)
      # `gh api repos/o/n --jq .default_branch`
      printf 'main\n'; exit 0 ;;
  esac
  exit 0
fi

exit 0
