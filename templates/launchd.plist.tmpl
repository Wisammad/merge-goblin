<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__CLI__</string>
        <string>run</string>
        <string>--scheduled</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>GOBLIN_HOME</key>
        <string>__GOBLIN_HOME__</string>
        <key>GOBLIN_APP</key>
        <string>__GOBLIN_APP__</string>
    </dict>

    <!-- Run at login, then on an interval. A missed run (asleep) fires on wake. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>__INTERVAL__</integer>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__GOBLIN_HOME__/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__GOBLIN_HOME__/launchd.log</string>
</dict>
</plist>
